# Copie para .env e preencha somente no seu computador.
# Banco principal (NUNCA usar em testes de integração).
DATABASE_URL=

# Chave forte e exclusiva de sessão; nunca publicar.
SESSION_SECRET=

# Outro banco/projeto PostgreSQL, exclusivo para testes com escrita.
TEST_DATABASE_URL=

# Opcional: caminho para o certificado CA PostgreSQL do Supabase.
# Exemplo Windows: C:/certificados/supabase-ca.crt
DB_SSL_CA_PATH=
